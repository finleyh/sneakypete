# Copy to .env and fill in before `docker compose up`.

# Postgres
PG_USER=honeypot
PG_PASSWORD=changeme-use-a-real-secret
PG_DATABASE=honeypot

# Tailscale IP of THIS host. Postgres is bound only to this address so it is
# reachable from Trino over the tailnet and never on the public interface.
# Find it with: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# IP this host's honeypot listeners (sip/ami/magnusbilling/cowrie) bind to.
# Defaults to 0.0.0.0 (all interfaces) if unset. Set this to pin the decoys
# to a specific public interface on a multi-homed host.
BIND_IP=0.0.0.0

# Optional: override the fake version banners the decoys present.
# ASTERISK_VERSION_BANNER=Asterisk PBX 18.9.0
# SIP_REALM=asterisk
# AMI_VERSION_BANNER=Asterisk Call Manager/8.4.0
# MAGNUSBILLING_VERSION_BANNER=MagnusBilling 7.3.0
# PHP_VERSION_BANNER=PHP/7.4.33
# APACHE_VERSION_BANNER=Apache/2.4.41 (Ubuntu)

# AMI honeypot: which credentials let a connection in. Defaults to a small
# seeded list of real-world defaults (admin/amp111 -- FreePBX's infamous
# default -- plus a few common weak choices). Comma-separated user:pass pairs.
# AMI_DEFAULT_CREDS=admin:amp111,admin:admin

# AMI honeypot: once logged in, simulate fake in-progress calls after
# Originate, QueueStatus/QueueAdd, and DBGet/DBPut against a fake AstDB.
# Defaults to true. Set false to fall back to the simpler emulation (static
# empty channel/queue/db responses) without a code change/revert.
# AMI_RICH_EMULATION=true
